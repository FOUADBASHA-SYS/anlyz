# ============================================================================
# Cloud XDR URL Threat Analyzer - Environment Configuration Example
# Copy this file to .env and replace placeholder values before deployment.
# ============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME="Cloud XDR URL Threat Analyzer"

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=url_analyzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql+psycopg2://postgres:replace_with_strong_database_password@postgres:5432/url_analyzer

# Redis Queue & Caching
REDIS_URL=redis://redis:6379/0

# Security Secrets (Must be at least 32 random characters in production)
SECRET_KEY=generate_random_secret_key_at_least_32_chars_long
CSRF_SECRET=generate_random_csrf_secret_key_at_least_32_chars

# Cookie & Session Settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_EXPIRE_MINUTES=1440
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Initial Admin Bootstrap Account
INITIAL_ADMIN_EMAIL=admin@xdr.local
INITIAL_ADMIN_PASSWORD=AdminStrongPassword2026!

# Scanner / Sandbox Limits
ALLOW_PRIVATE=0
WORKERS=4
ANALYSIS_TIMEOUT_MS=30000
MAX_BULK_ROWS=500

# Storage Paths
STORAGE_DIR=./storage
SCREENSHOT_DIR=./storage/screenshots
REPORTS_DIR=./storage/reports

# External Threat Intelligence APIs (Optional)
VT_API_KEY=
GSB_API_KEY=

# AI Provider API Keys (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
